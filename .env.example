# Supabase Core Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Database Connection (PostgreSQL / SQLAlchemy)
DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# Authentication & Storage Settings
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_BUCKET_NAME=media
MEDIA_MAX_BYTES=52428800
MEDIA_SIGNED_URL_TTL=300
SHARE_LINK_BASE_URL
GROQ_API_KEY
GEMINI_API_KEY

# CORS: comma-separated list of ALLOWED FRONTEND origins (where requests come FROM,
# not where they go to). Set locally for dev; production value lives in Render.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000